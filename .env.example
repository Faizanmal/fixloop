# ==========================================================
# FixLoop Environment Configuration Template
# Copy this file to .env and configure your local credentials
# ==========================================================

# Nebius Token Factory Configuration
# Obtain your API key from the Nebius console / AI Studio (https://studio.nebius.ai/ or https://tokenfactory.nebius.com)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional Fallback / Mock Mode:
# Set to 'true' to run FixLoop using deterministic mocked LLM responses
# (useful when offline, testing test suites, or running without cloud credits)
USE_MOCK_LLM=false

# Backend Server Configuration
FIXLOOP_HOST=0.0.0.0
FIXLOOP_PORT=8000
DEBUG_MODE=false
# Comma-separated allowed origins (e.g., your Vercel deployment URL or localhost)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
# Regex pattern for allowed origins (matches all Vercel preview & production deployments)
CORS_ORIGIN_REGEX=^https?://.*\.vercel\.app$

# Docker & Sandbox Configuration
DOCKER_HOST_OVERRIDE=
DOCKER_COMMAND_TIMEOUT_SECONDS=30
MAX_DIAGNOSTIC_ITERATIONS=5
REQUIRE_APPROVAL_FOR_CONTAINER_RESTART=true

# Next.js Frontend Configuration (Configured in Vercel project environment settings)
# Option A (Server-to-Server Proxy - No SSL domain needed on VM):
#   BACKEND_API_URL=http://<YOUR_GCP_VM_EXTERNAL_IP>:8000
#   NEXT_PUBLIC_API_BASE_URL=""
# Option B (Direct HTTPS domain via Caddy or Cloudflare):
#   NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_API_URL=http://127.0.0.1:8000
